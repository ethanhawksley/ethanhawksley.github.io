---
import Moon from '../assets/moon.svg';
import Sun from '../assets/sun.svg';
---

<button type="button" id="theme-toggle" aria-label="Switch to dark theme">
  <Moon class="moon" aria-hidden="true" />
  <Sun class="sun" aria-hidden="true" />
</button>

<style>
  @property --hover-mix {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 0%;
  }

  button {
    position: relative;
    display: none;
    align-items: center;
    justify-content: center;
    inline-size: 3rem;
    block-size: 3rem;
  }

  :global(.js) button {
    display: flex;
  }

  .sun,
  .moon {
    position: absolute;
    inline-size: 2rem;
    block-size: 2rem;
    color: color-mix(
      in oklch,
      var(--color-accent) var(--hover-mix),
      var(--color-text)
    );
    transition:
      --hover-mix 250ms ease-out,
      opacity 250ms ease-out;
  }

  .sun {
    opacity: 0;
  }

  :global([data-theme='dark']) .moon {
    opacity: 0;
  }

  :global([data-theme='dark']) .sun {
    opacity: 1;
  }

  @media (hover: hover) {
    button:hover > .sun,
    button:hover > .moon {
      --hover-mix: 100%;
    }
  }
</style>

<script>
  const mediaQuery = matchMedia('(prefers-color-scheme: dark)');

  function initThemeToggle() {
    const button = document.getElementById('theme-toggle')!;

    const updateAria = (theme: 'light' | 'dark') => {
      button.setAttribute(
        'aria-label',
        theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
      );
    };

    updateAria(window.__getTheme());

    button.addEventListener('click', () => {
      const nextTheme = window.__getTheme() === 'dark' ? 'light' : 'dark';
      window.__setTheme(nextTheme, true);
      updateAria(nextTheme);
    });

    const controller = new AbortController();

    window.addEventListener(
      'storage',
      (e) => {
        if (e.key === 'theme') {
          const isDark =
            e.newValue === 'dark' ||
            (e.newValue === null && mediaQuery.matches);
          const theme = isDark ? 'dark' : 'light';

          window.__setTheme(theme, false);
          updateAria(theme);
        }
      },
      { signal: controller.signal },
    );

    mediaQuery.addEventListener(
      'change',
      (e) => {
        try {
          if (localStorage.getItem('theme') !== null) return;
        } catch {}

        const theme = e.matches ? 'dark' : 'light';
        window.__setTheme(theme, false);
        updateAria(theme);
      },
      { signal: controller.signal },
    );

    document.addEventListener('astro:before-swap', () => controller.abort(), {
      once: true,
    });
  }

  document.addEventListener('astro:page-load', initThemeToggle);
</script>
