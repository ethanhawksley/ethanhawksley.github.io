---
import ThemeToggle from './ThemeToggle.astro';
import LogoRounded from '../assets/hawksley-dev-logo-rounded.svg';

const cleanPath =
  Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/$/, '') || '/';

const isHome = cleanPath === '/';
const isBlogIndex = cleanPath === '/blog';
const isBlog = cleanPath.startsWith('/blog');
---

<header>
  <nav aria-label="Main">
    <a href="/" aria-label="Home" class="logo"
      ><LogoRounded width="3rem" height="3rem" aria-hidden="true" /></a
    >
    <div class="page-links">
      <a
        href="/"
        class:list={[{ active: isHome }]}
        aria-current={isHome ? 'page' : undefined}
      >
        Home</a
      >
      <a
        href="/blog"
        class:list={[{ active: isBlog }]}
        aria-current={isBlogIndex ? 'page' : isBlog ? 'true' : undefined}
      >
        Blog</a
      >
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
    padding-right: max(1.5rem, env(safe-area-inset-right));
    padding-left: max(1.5rem, env(safe-area-inset-left));
  }

  .logo {
    width: 3rem;
    height: 3rem;
  }

  .page-links {
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
  }

  a {
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: var(--leading-tight);
    color: inherit;
    text-decoration: none;
  }

  .page-links a {
    padding: 0.65rem 0.25rem;
    margin: -0.65rem -0.25rem;
  }

  .active {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  a:hover {
    color: var(--color-accent);
  }

  a:active {
    transform: scale(0.96);
  }
</style>
