---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import LatestPosts from '../components/LatestPosts.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getSortedPosts, getSortedProjects } from '../utils/content-helpers';
import { personJsonLd, websiteJsonLd } from '../utils/jsonLd';

// Inline low quality avif since home page fits into initcwd
// On Cloudflare, initcwd is ~40KB.
const inlineImagePath = path.join(
  process.cwd(),
  'src/assets/ethan-hawksley-320.avif',
);
const inlineImageBuffer = fs.readFileSync(inlineImagePath);
const inlineImageBase64 = `data:image/avif;base64,${inlineImageBuffer.toString('base64')}`;

const ogImageUrl = new URL('/og/home.jpg', Astro.site).toString();

const allProjects = await getSortedProjects();

const projectJsonLds = allProjects.map((project) => {
  const isWeb = project.data.type === 'Web';

  return {
    '@type': isWeb ? 'WebApplication' : 'SoftwareApplication',
    '@id': project.data.id,
    url: project.data.url,
    name: project.data.name,
    description: project.data.description,
    applicationCategory: project.data.applicationCategory,
    creator: { '@id': 'https://hawksley.dev#person' },
    sameAs: project.data.links?.map((link) => link.url),
  };
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    personJsonLd,
    websiteJsonLd,
    {
      '@type': 'ProfilePage',
      '@id': 'https://hawksley.dev#webpage',
      url: 'https://hawksley.dev',
      isPartOf: { '@id': 'https://hawksley.dev#website' },
      name: 'About Ethan Hawksley',
      inLanguage: 'en',
      mainEntity: { '@id': 'https://hawksley.dev#person' },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: 'https://hawksley.dev/ethan-hawksley.jpg',
        name: 'Ethan Hawksley',
        caption: 'Headshot of Ethan Hawksley, Computer Science student',
        width: 1536,
        height: 1536,
      },
    },
    ...projectJsonLds,
  ],
};
---

<Layout
  title="Ethan Hawksley"
  description="The personal site and blog of Ethan Hawksley, a Computer Science student in the UK with a focus on systems programming and cybersecurity."
  jsonLd={jsonLd}
  ogType="website"
  ogImage={ogImageUrl}
>
  <section class="hero">
    <div class="hero-content">
      <h1>Ethan Hawksley</h1>
      <p class="hero-lead">
        Ethan Hawksley is a Computer Science student in the UK with a focus on
        systems programming and cybersecurity.
      </p>
      <p>That's me! I&nbsp;use hawksley.dev to share all my projects.</p>
      <SocialLinks />
    </div>
    <picture>
      <source srcset="/ethan-hawksley.avif" type="image/avif" />
      <img
        class="hero-avatar"
        src="/ethan-hawksley.jpg"
        alt="Headshot of Ethan Hawksley, Computer Science student"
        width="160"
        height="160"
        loading="lazy"
        fetchpriority="low"
        decoding="async"
        style={`background-image:url(${inlineImageBase64})`}
      />
    </picture>
  </section>
  <section class="projects" aria-labelledby="projects-heading">
    <h2 id="projects-heading">Projects</h2>
    <ul role="list">
      {
        allProjects.map((project) => (
          <ProjectPreview
            name={project.data.name}
            description={project.data.description}
            links={project.data.links}
            url={project.data.url}
            type={project.data.type}
            stack={project.data.stack}
          />
        ))
      }
    </ul>
  </section>
  <section aria-labelledby="blog-heading">
    <h2 id="blog-heading">Latest Posts</h2>
    <p>Articles primarily on tech, but also whatever grabs my attention.</p>
    <LatestPosts />
  </section>
</Layout>

<style>
  .hero {
    display: flex;
    flex-direction: column-reverse;
    gap: 1.5rem;
    align-items: flex-start;
    margin-bottom: 1.5rem;
  }

  .hero p {
    max-width: 43ch;
    text-wrap: balance;
  }

  .hero-lead {
    width: fit-content;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-avatar {
    width: 120px;
    height: 120px;
    color: transparent;
    -webkit-user-select: none;
    user-select: none;
    object-fit: cover;
    background-color: #3e631f;
    background-position: center;
    background-size: cover;
    border: 2px solid var(--color-border);
    border-radius: 50%;
    filter: none !important;
  }

  @media (min-width: 41em) {
    .hero {
      flex-direction: row;
      gap: 0;
      justify-content: space-between;
    }

    .hero-avatar {
      width: 160px;
      height: 160px;
    }
  }

  h2 {
    margin-bottom: 1rem;
  }

  p {
    line-height: var(--leading-normal);
  }

  .projects {
    margin-bottom: 2rem;
  }
</style>
