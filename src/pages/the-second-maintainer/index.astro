---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import { personJsonLd, websiteJsonLd } from '../../utils/jsonLd';
import { getCollection } from 'astro:content';

const allChapters = await getCollection('theSecondMaintainer');

// Inline low quality avif since book index fits into initcwd
// On Cloudflare, initcwd is ~40KB.
const inlineImagePath = path.join(
  process.cwd(),
  'src/assets/the-second-maintainer-400x640.avif',
);
const inlineImageBuffer = fs.readFileSync(inlineImagePath);
const inlineImageBase64 = `data:image/avif;base64,${inlineImageBuffer.toString('base64')}`;

const ogImageUrl = new URL(
  '/og/the-second-maintainer.jpg',
  Astro.site,
).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    personJsonLd,
    websiteJsonLd,
    {
      '@type': 'ProfilePage',
      '@id': 'https://hawksley.dev#webpage',
      url: 'https://hawksley.dev',
      isPartOf: { '@id': 'https://hawksley.dev#website' },
      name: 'About Ethan Hawksley',
      inLanguage: 'en',
      mainEntity: { '@id': 'https://hawksley.dev#person' },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: 'https://hawksley.dev/ethan-hawksley.jpg',
        name: 'Ethan Hawksley',
        caption: 'Headshot of Ethan Hawksley, Computer Science student',
        width: 1536,
        height: 1536,
      },
    },
  ],
};
---

<Layout
  title="Ethan Hawksley"
  description="The personal site and blog of Ethan Hawksley, a Computer Science student in the UK with a focus on systems programming and cybersecurity."
  jsonLd={jsonLd}
  ogType="website"
  ogImage={ogImageUrl}
>
  <section class="hero">
    <div class="hero-content">
      <h1>The Second Maintainer</h1>
      <p class="hero-lead">
        Ethan Hawksley is a Computer Science student in the UK with a focus on
        systems programming and cybersecurity.
      </p>
      <p>That's me! I&nbsp;use hawksley.dev to share all my projects.</p>
    </div>
    <picture>
      <img
        class="hero-avatar"
        src="/the-second-maintainer/the-second-maintainer.jpg"
        alt="Headshot of Ethan Hawksley, Computer Science student"
        width="200"
        height="320"
        loading="lazy"
        fetchpriority="low"
        decoding="async"
        style={`background-image:url(${inlineImageBase64})`}
      />
    </picture>
  </section>
  <section class="projects" aria-labelledby="projects-heading">
    <h2 id="projects-heading">Projects</h2>
    <ul role="list">
      {allChapters.map((project) => <li />)}
    </ul>
  </section>
  <section aria-labelledby="blog-heading">
    <h2 id="blog-heading">Latest Posts</h2>
    <p>Articles primarily on tech, but also whatever grabs my attention.</p>
  </section>
</Layout>

<style>
  .hero {
    display: flex;
    flex-direction: column-reverse;
    gap: 1.5rem;
    align-items: flex-start;
    margin-bottom: 1.5rem;
  }

  .hero p {
    max-width: 43ch;
    text-wrap: balance;
  }

  .hero-lead {
    width: fit-content;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-avatar {
    width: 160px;
    height: 256px;
    color: transparent;
    -webkit-user-select: none;
    user-select: none;
    object-fit: cover;
    background-color: #191919;
    background-position: center;
    background-size: cover;
    border: 2px solid var(--color-border);
    filter: none !important;
  }

  @media (min-width: 41em) {
    .hero {
      flex-direction: row;
      gap: 0;
      justify-content: space-between;
    }

    .hero-avatar {
      width: 200px;
      height: 320px;
    }
  }

  h2 {
    margin-bottom: 1rem;
  }

  p {
    line-height: var(--leading-normal);
  }

  .projects {
    margin-bottom: 2rem;
  }
</style>
