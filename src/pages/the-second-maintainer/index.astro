---
import Layout from '../../layouts/Layout.astro';
import { personJsonLd, websiteRef } from '../../utils/jsonLd';
import { getCollection } from 'astro:content';

const allChapters = await getCollection('theSecondMaintainer');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    personJsonLd,
    websiteRef,
    {
      '@type': 'CollectionPage',
      '@id': 'https://hawksley.dev/blog#webpage',
      url: 'https://hawksley.dev/blog',
      isPartOf: { '@id': 'https://hawksley.dev#website' },
      name: "Ethan Hawksley's Blog",
      description:
        'A blog by Ethan Hawksley, a Computer Science student in the UK. Articles on systems programming, cybersecurity, and whatever else grabs my attention.',
      inLanguage: 'en',
      mainEntity: { '@id': 'https://hawksley.dev/blog#blog' },
      breadcrumb: { '@id': 'https://hawksley.dev/blog#breadcrumb' },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: 'https://hawksley.dev/ethan-hawksley.jpg',
        name: 'Ethan Hawksley',
        caption: 'Headshot of Ethan Hawksley, Computer Science student',
        width: 1536,
        height: 1536,
      },
    },
    {
      '@type': 'Blog',
      '@id': 'https://hawksley.dev/blog#blog',
      isPartOf: { '@id': 'https://hawksley.dev#website' },
      mainEntityOfPage: { '@id': 'https://hawksley.dev/blog#webpage' },
      name: "Ethan Hawksley's Blog",
      description:
        'A blog by Ethan Hawksley, a Computer Science student in the UK. Articles on systems programming, cybersecurity, and whatever else grabs my attention.',
      inLanguage: 'en',
      publisher: { '@id': 'https://hawksley.dev#person' },
      license: 'https://creativecommons.org/licenses/by/4.0/',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://hawksley.dev/blog#breadcrumb',
      itemListElement: [
        {
          '@type': 'ListItem',
          item: 'https://hawksley.dev',
          position: 1,
          name: 'Home',
        },
        {
          '@type': 'ListItem',
          item: 'https://hawksley.dev/blog',
          position: 2,
          name: 'Blog',
        },
      ],
    },
  ],
};

const ogImageUrl = new URL(
  '/og/the-second-maintainer.jpg',
  Astro.site,
).toString();
---

<Layout
  title="The Second Maintainer | Ethan Hawksley"
  description="A blog by Ethan Hawksley, a Computer Science student in the UK. Posts on systems programming, cybersecurity, and whatever else grabs my attention."
  jsonLd={jsonLd}
  ogType="website"
  ogImage={ogImageUrl}
>
  <h1>Blog</h1>
  <p>Articles primarily on tech, but also whatever grabs my attention.</p>
  <ul role="list">
    {allChapters.map((chapter) => <li>{chapter.data.title}</li>)}
  </ul>
</Layout>
<style>
  p {
    max-width: 65ch;
    margin-bottom: 1rem;
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
    text-wrap: balance;
  }
</style>
